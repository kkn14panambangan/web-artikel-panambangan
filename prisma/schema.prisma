generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Article {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  author    String   @default("Administrator")
  image_url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Journal {
  id        String   @id @default(uuid())
  title     String
  pdf_url   String
  author    String   @default("Administrator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
